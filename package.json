{
    "name": "neat-todo",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "workspaces": [
        "frontend",
        "server"
    ],
    "scripts": {
        "dev": "concurrently 'bun run dev:frontend' 'bun run dev:server'",
        "dev:all": "concurrently 'bun run dev:frontend' 'bun run dev:server:db'",
        "dev:server:db": "concurrently 'bun run db' 'sleep 3 && bun run dev:server'",
        "dev:frontend": "cd frontend && next dev",
        "dev:server": "cd server && bun --watch index.ts",
        "build": "concurrently 'bun run build:frontend' 'bun run build:server'",
        "build:frontend": "cd frontend && next build",
        "build:server": "cd server && tsc && bun build/index.js",
        "lint:frontend": "cd frontend && next lint",
        "typecheck:server": "cd server && tsc --noEmit",
        "db": "cd docker && docker compose --env-file ../server/.env up"
    },
    "author": "LoicE5",
    "license": "GPL-3.0-only",
    "devDependencies": {
        "@types/node": "^25",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "autoprefixer": "^10.0.1",
        "concurrently": "^9.1.2",
        "eslint": "^9",
        "eslint-config-next": "^16",
        "postcss": "^8",
        "tailwindcss": "^3.3.0",
        "typescript": "^5"
    },
    "type": "commonjs",
    "dependencies": {
        "@preact/signals-react": "^2.2.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/body-parser": "^1.19.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5",
        "@types/express-serve-static-core": "^5",
        "@types/jsonwebtoken": "^9",
        "@types/passport-jwt": "^3.0.13",
        "@types/pg": "^8.11.0",
        "@types/qs": "^6",
        "@types/sequelize": "^4.28.18",
        "@types/serve-static": "^1",
        "@types/validator": "^13",
        "@vercel/analytics": "^1.4.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "express": "^5",
        "framer-motion": "^11.18.2",
        "jsonwebtoken": "^9.0.2",
        "next": "^16",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.11.3",
        "react": "^19",
        "react-dom": "^19",
        "react-player": "^2.13.0",
        "sequelize": "^6.37.8",
        "validator": "^13.15.0"
    }
}
