meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "testuser@example.com",
    "password": "TestPassword123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token)
    bru.setEnvVar("userId", res.body.user.id)
  }
}

tests {
  test("status is 200 OK", function() {
    expect(res.status).to.equal(200)
  })

  test("response has message ok", function() {
    expect(res.body.message).to.equal("ok")
  })

  test("response has a JWT token", function() {
    expect(res.body).to.have.property("token")
    expect(typeof res.body.token).to.equal("string")
    expect(res.body.token.length).to.be.greaterThan(0)
  })

  test("response has user data without password", function() {
    expect(res.body).to.have.property("user")
    expect(res.body.user).to.have.property("id")
    expect(res.body.user).to.have.property("email")
    expect(res.body.user).to.have.property("nickname")
    expect(res.body.user).not.to.have.property("password")
  })
}
