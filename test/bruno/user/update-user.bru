meta {
  name: Update User By ID
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/user/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nickname": "{{testNickname}}upd"
  }
}

tests {
  test("status is 200 OK", function() {
    expect(res.status).to.equal(200)
  })
}
