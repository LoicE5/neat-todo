meta {
  name: Create Group
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/group
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Test Group",
    "firstUsersEmails": ["{{testEmail}}"]
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("groupId", res.body.id)
  }
}

tests {
  test("status is 201 Created", function() {
    expect(res.status).to.equal(201)
  })

  test("response has group data", function() {
    expect(res.body).to.have.property("id")
    expect(res.body).to.have.property("name")
  })

  test("group name matches the request", function() {
    expect(res.body.name).to.equal("Test Group")
  })
}
